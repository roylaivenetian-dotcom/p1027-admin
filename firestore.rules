rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // P1027 Admin / sick-meal — Spark-friendly (no Cloud Functions required).
    // TRADEOFF: Grok/feed bot + Menu admin write via Firebase client SDK
    // with a shared writeToken field. Anyone who knows the token can write.
    // Token value is injected at deploy from internal/ingest-key.txt
    // (placeholder REPLACE_WRITE_TOKEN must not ship as the real secret in git).
    // Public READ for https://sick-meal.web.app without Auth.

    function hasWriteToken() {
      return request.resource.data.writeToken is string
        && request.resource.data.writeToken == 'REPLACE_WRITE_TOKEN';
    }

    function existingHasWriteToken() {
      return resource.data.writeToken is string
        && resource.data.writeToken == 'REPLACE_WRITE_TOKEN';
    }

    function isValidOrder() {
      return request.resource.data.keys().hasAll(['person', 'date', 'dish', 'amount', 'onMenu', 'updatedAt', 'writeToken'])
        && request.resource.data.person is string
        && request.resource.data.date is string
        && request.resource.data.dish is string;
    }

    function isValidLeave() {
      return request.resource.data.keys().hasAll(['person', 'month', 'type', 'dates', 'updatedAt', 'writeToken'])
        && request.resource.data.person is string
        && request.resource.data.month is string
        && request.resource.data.type is string
        && request.resource.data.dates is list;
    }

    function isValidWeeklyReport() {
      return request.resource.data.keys().hasAll(['weekId', 'weekStart', 'weekEnd', 'grandTotal', 'updatedAt', 'writeToken'])
        && request.resource.data.weekId is string;
    }

    function isValidMenuItem() {
      return request.resource.data.keys().hasAll(['nameZh', 'category', 'priceHkd', 'active', 'updatedAt', 'writeToken'])
        && request.resource.data.nameZh is string
        && request.resource.data.category is string
        && request.resource.data.priceHkd is number
        && (
          !('weekday' in request.resource.data)
          || request.resource.data.weekday == null
          || (request.resource.data.weekday is string
              && request.resource.data.weekday.matches('^(mon|tue|wed|thu|fri|sat)$'))
        );
    }

    function isValidMenuPhoto() {
      return request.resource.data.keys().hasAll(['effectiveFrom', 'updatedAt', 'writeToken'])
        && request.resource.data.effectiveFrom is string
        && request.resource.data.effectiveFrom.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (
          request.resource.data.effectiveTo == null
          || (request.resource.data.effectiveTo is string
              && request.resource.data.effectiveTo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        );
    }

    match /people/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Optional text captions / aliases (secondary to menuPhotos)
    match /menuItems/{id} {
      allow read: if true;
      allow create, update: if hasWriteToken() && isValidMenuItem();
      allow delete: if existingHasWriteToken();
    }

    // Dated menu photos — primary fixed menu for Grok OCR matching
    match /menuPhotos/{id} {
      allow read: if true;
      allow create, update: if hasWriteToken() && isValidMenuPhoto();
      allow delete: if existingHasWriteToken();
    }

    // Menu OCR jobs — Menu admin queues image; P1027 Admin Grok bot fills dishes
    function isValidMenuVisionJob() {
      return request.resource.data.keys().hasAll(['status', 'updatedAt', 'writeToken'])
        && request.resource.data.status is string
        && request.resource.data.updatedAt is string;
    }

    match /menuVisionJobs/{id} {
      allow read: if true;
      allow create, update: if hasWriteToken() && isValidMenuVisionJob();
      allow delete: if existingHasWriteToken();
    }

    match /orders/{id} {
      allow read: if true;
      allow create, update: if hasWriteToken() && isValidOrder();
      allow delete: if false;
    }

    match /leaveRequests/{id} {
      allow read: if true;
      allow create, update: if hasWriteToken() && isValidLeave();
      allow delete: if false;
    }

    match /weeklyReports/{id} {
      allow read: if true;
      allow create, update: if hasWriteToken() && isValidWeeklyReport();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

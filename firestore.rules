rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // P1027 Admin / sick-meal
    // Cloud Function `api` writes with Admin SDK (bypasses these rules).
    // Temporary demo: public READ so https://sick-meal.web.app works without Auth.
    // Client writes remain denied. Tighten to request.auth != null once Auth is wired.

    match /people/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /menuItems/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /orders/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /leaveRequests/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /weeklyReports/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

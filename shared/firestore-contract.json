{
  "$comment": "Aligned with /cursor/stores/self/docs/food-leave-app.md Bot feed + whatsapp-food-feed",
  "projectId": "sick-meal",
  "collections": {
    "orders": {
      "docId": "stable from person+date+sourceMessageId",
      "fields": {
        "id": "string",
        "person": "string (Ken, Yin, Ric, Roy, Tim, …)",
        "date": "YYYY-MM-DD HKT",
        "dish": "string",
        "soup": "boolean",
        "drink": "string|null",
        "extras": "string[]",
        "onMenu": "boolean — false excluded from totals",
        "amount": "number — 50, 55, or 0 off-menu",
        "remark": "string|null",
        "sourceJid": "string|null",
        "sourceMessageId": "string|null",
        "updatedAt": "ISO string"
      }
    },
    "leaveRequests": {
      "docId": "recordId",
      "fields": {
        "person": "string",
        "month": "YYYY-MM",
        "type": "string (default leave)",
        "dates": "string[]",
        "note": "string|null",
        "sourceJid": "string|null",
        "sourceMessageId": "string|null",
        "updatedAt": "ISO string"
      }
    },
    "weeklyReports": {
      "docId": "{weekStart}_{weekEnd}",
      "fields": ["weekId", "weekStart", "weekEnd", "timezone", "personTotals", "grandTotal", "orders", "generatedAt", "updatedAt", "note?"]
    }
  },
  "pricing": { "meal": 50, "soup": 0, "drink": 5, "offMenuAmount": 0 },
  "writers": "whatsapp-food-feed Admin SDK — not the web client",
  "readers": "web app prefers live orders; mock fallback same shape"
}

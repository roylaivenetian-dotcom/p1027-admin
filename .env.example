# Copy to .env.local and fill with your Firebase web app config.
# Never commit real keys. Project: sick-meal (example).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=sick-meal
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Spark writeToken for Menu admin + bot client writes (same as internal/ingest-key.txt)
# VITE_FIREBASE_WRITE_TOKEN=

# Gemini vision (browser). Prefer a paid key if free-tier 429s appear.
# Restrict to https://sick-meal.web.app/* referrers in Google Cloud Console.
# VITE_GEMINI_API_KEY=
# VITE_GEMINI_MODEL=gemini-2.5-flash

# Optional DashScope / Qwen VL fallback (OpenAI-compatible, Hong Kong MaaS).
# When Gemini hits location/quota errors, Menu OCR tries Qwen next.
# VITE_DASHSCOPE_API_KEY=          # Model Studio key for CN-Hong Kong region
# VITE_DASHSCOPE_WORKSPACE_ID=     # → https://{id}.cn-hongkong.maas.aliyuncs.com/compatible-mode/v1
# VITE_DASHSCOPE_MODEL=qwen3-vl-plus
# Or override base fully:
# VITE_DASHSCOPE_BASE_URL=https://{WorkspaceId}.cn-hongkong.maas.aliyuncs.com/compatible-mode/v1

# Optional: shared secret for bot ingest Cloud Function (server-side only)
# INGEST_API_KEY=

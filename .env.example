# Copy to .env.local and fill with your Firebase web app config.
# Never commit real keys. Project: sick-meal (example).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=sick-meal
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Spark writeToken for Menu admin + bot client writes (same as internal/ingest-key.txt)
# VITE_FIREBASE_WRITE_TOKEN=

# Optional: Gemini vision for Menu OCR (defaults to VITE_FIREBASE_API_KEY when
# generativelanguage.googleapis.com is enabled on the Firebase project).
# Restrict the key to https://sick-meal.web.app/* referrers in Google Cloud Console.
# VITE_GEMINI_API_KEY=
# VITE_GEMINI_MODEL=gemini-3.5-flash

# Optional: shared secret for bot ingest Cloud Function (server-side only)
# INGEST_API_KEY=

# Copy to .env.local and fill with your Firebase web app config.
# Never commit real keys. Project: sick-meal (example).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=sick-meal
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Spark writeToken for Menu admin + bot client writes (same as internal/ingest-key.txt)
# Also required to queue menuVisionJobs for the P1027 Admin Grok bot.
# VITE_FIREBASE_WRITE_TOKEN=

# Optional: hosted whatsapp-food-feed Agent SDK URL to nudge menu-vision channel.
# When unset, the bot still picks up Firestore menuVisionJobs via its schedule.
# VITE_GROK_BOT_URL=https://<alias>.agents.cursor.com/whatsapp-food-feed
# VITE_GROK_BOT_ALIAS_TOKEN=

# Optional: shared secret for bot ingest Cloud Function (server-side only)
# INGEST_API_KEY=
